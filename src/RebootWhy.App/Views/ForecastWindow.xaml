<Window x:Class="RebootWhy.App.Views.ForecastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:RebootWhy.App.Infrastructure"
        xmlns:l="clr-namespace:RebootWhy.App.Properties"
        Icon="pack://application:,,,/Assets/RebootWhy.ico"
        Title="{x:Static l:Strings.ForecastWin_Title}"
        Width="680" SizeToContent="Height" MaxHeight="820" ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen" Background="{StaticResource SurfaceBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13" Foreground="{StaticResource TextBrush}">
    <Window.Resources>
        <DataTemplate x:Key="Bullet">
            <DockPanel Margin="0,2">
                <TextBlock DockPanel.Dock="Left" Text="•" Margin="0,0,6,0" />
                <TextBlock infra:LinkText.Text="{Binding}" TextWrapping="Wrap" />
            </DockPanel>
        </DataTemplate>
        <Style x:Key="Band" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SuccessBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="Warning">
                    <Setter Property="Background" Value="{StaticResource DangerBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="Critical">
                    <Setter Property="Background" Value="{StaticResource DangerBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="Sample">
                    <Setter Property="Background" Value="#41546B" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Band}" Padding="20,16">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="{Binding HeaderGlyph}" FontFamily="{StaticResource IconFont}" FontSize="26" Foreground="White"
                           VerticalAlignment="Center" Margin="0,0,14,0" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- The sound is turned off where people look first: in the alert header. -->
                    <Button Command="{Binding StopSoundCommand}" Margin="12,0,0,0" Padding="12,5" Background="Transparent" BorderBrush="White" Foreground="White"
                            Visibility="{Binding IsSoundPlaying, Converter={StaticResource Visible}}"
                            ToolTip="{x:Static l:Strings.ForecastWin_StopSoundTip}">
                        <Button.Resources>
                            <SolidColorBrush x:Key="HoverBrush" Color="#33FFFFFF" />
                            <SolidColorBrush x:Key="PressedBrush" Color="#55FFFFFF" />
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE74F;" FontSize="14" Foreground="White" Margin="0,0,8,0" />
                            <TextBlock Text="{x:Static l:Strings.ForecastWin_StopSound}" Foreground="White" />
                        </StackPanel>
                    </Button>
                    <Border Background="#FFFFFF" CornerRadius="10" Padding="10,3" Margin="12,0,0,0" VerticalAlignment="Center"
                            Visibility="{Binding BadgeText, Converter={StaticResource Visible}}">
                        <TextBlock Text="{Binding BadgeText}" FontWeight="Bold" FontSize="11" Foreground="#41546B" />
                    </Border>
                </StackPanel>
                <TextBlock Text="{Binding Header}" Foreground="White" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- Buttons in one row: "Remind me" on the left, the main ones on the right -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource SubtleBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="20,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding ShowSnooze, Converter={StaticResource Visible}}" IsEnabled="{Binding CanSnooze}">
                    <Button Command="{Binding SnoozeCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE916;" FontSize="13" Margin="0,0,8,0" />
                            <TextBlock Text="{x:Static l:Strings.ForecastWin_Snooze}" />
                        </StackPanel>
                    </Button>
                    <ComboBox Width="150" Margin="8,0,0,0" ItemsSource="{Binding SnoozeOptions}" SelectedItem="{Binding SelectedSnooze}" DisplayMemberPath="Title" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Margin="0,0,8,0" Content="{x:Static l:Strings.ForecastWin_OpenMain}" Command="{Binding OpenMainCommand}"
                            Visibility="{Binding IsSample, Converter={StaticResource Visible}, ConverterParameter=Invert}" />
                    <Button Style="{StaticResource AccentButton}" MinWidth="110" IsDefault="True" IsCancel="True" Command="{Binding CloseCommand}">
                        <Grid>
                            <TextBlock Text="{x:Static l:Strings.ForecastWin_GotIt}" Visibility="{Binding IsSample, Converter={StaticResource Visible}, ConverterParameter=Invert}" />
                            <TextBlock Text="{x:Static l:Strings.ForecastWin_CloseSample}" Visibility="{Binding IsSample, Converter={StaticResource Visible}}" />
                        </Grid>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,16,20,16">
                <TextBlock Text="{Binding Summary}" FontSize="15" TextWrapping="Wrap" />
                <TextBlock Text="{Binding WhenText}" FontWeight="SemiBold" FontSize="14" Margin="0,8,0,0"
                           Visibility="{Binding WhenText, Converter={StaticResource Visible}}" />
                <TextBlock Text="{Binding NextWorkText}" Style="{StaticResource Caption}" FontSize="13" Margin="0,8,0,0"
                           Visibility="{Binding NextWorkText, Converter={StaticResource Visible}}" />
                <TextBlock Text="{Binding SnoozeWarning}" Foreground="{StaticResource DangerBrush}" Margin="0,8,0,0" TextWrapping="Wrap"
                           Visibility="{Binding SnoozeWarning, Converter={StaticResource Visible}}" />

                <!-- Reaction test: what it is and how to stop it -->
                <Border Margin="0,14,0,0" Padding="14,10" CornerRadius="8" Background="#EEF1F5" BorderBrush="#D3D9E2" BorderThickness="1"
                        Visibility="{Binding IsSimulation, Converter={StaticResource Visible}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="{x:Static l:Strings.ForecastWin_StopTest}" VerticalAlignment="Center" Margin="12,0,0,0" Command="{Binding StopSimulationCommand}" />
                        <TextBlock Style="{StaticResource Icon}" DockPanel.Dock="Left" Text="&#xE946;" Foreground="#41546B" Margin="0,0,10,0" VerticalAlignment="Top" />
                        <TextBlock TextWrapping="Wrap" VerticalAlignment="Center"
                                   Text="{x:Static l:Strings.ForecastWin_SimulationBanner}" />
                    </DockPanel>
                </Border>

                <!-- Hold against an automatic restart -->
                <Border Margin="0,14,0,0" Padding="14,12" CornerRadius="8" BorderThickness="1"
                        Visibility="{Binding ShowProtection, Converter={StaticResource Visible}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource WarningBackgroundBrush}" />
                            <Setter Property="BorderBrush" Value="{StaticResource WarningBorderBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ProtectionActive}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource SuccessBackgroundBrush}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource SuccessBorderBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" FontFamily="{StaticResource IconFont}" FontSize="24" VerticalAlignment="Top" Margin="0,0,12,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="&#xE7BA;" />
                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ProtectionActive}" Value="True">
                                            <Setter Property="Text" Value="&#xEA18;" />
                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button DockPanel.Dock="Right" Content="{x:Static l:Strings.ForecastWin_EnableProtection}" VerticalAlignment="Center" Margin="12,0,0,0"
                                Command="{Binding EnableProtectionCommand}" Visibility="{Binding CanEnableProtection, Converter={StaticResource Visible}}" />
                        <StackPanel>
                            <TextBlock Text="{Binding ProtectionTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding ProtectionText}" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{StaticResource SecondaryTextBrush}" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <StackPanel Visibility="{Binding HasUpdates, Converter={StaticResource Visible}}">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static l:Strings.ForecastWin_PendingSection}" />
                    <ItemsControl ItemsSource="{Binding Updates}" ItemTemplate="{StaticResource Bullet}" />
                </StackPanel>

                <StackPanel Visibility="{Binding HasNotes, Converter={StaticResource Visible}}">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static l:Strings.ForecastWin_WhySection}" />
                    <ItemsControl ItemsSource="{Binding Notes}" ItemTemplate="{StaticResource Bullet}" />
                </StackPanel>

                <StackPanel Visibility="{Binding HasProblems, Converter={StaticResource Visible}}">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static l:Strings.ForecastWin_ProblemsSection}" Foreground="{StaticResource DangerBrush}" />
                    <ItemsControl ItemsSource="{Binding Problems}" ItemTemplate="{StaticResource Bullet}" />
                </StackPanel>

                <StackPanel Visibility="{Binding HasEvidence, Converter={StaticResource Visible}}">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static l:Strings.ForecastWin_EvidenceSection}" />
                    <ItemsControl ItemsSource="{Binding Evidence}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,1" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <DockPanel Margin="0,16,0,0" Visibility="{Binding IsSample, Converter={StaticResource Visible}, ConverterParameter=Invert}">
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" MinWidth="140" Margin="12,0,0,0" VerticalAlignment="Center" Command="{Binding CheckCommand}">
                        <Grid>
                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsChecking, Converter={StaticResource Visible}, ConverterParameter=Invert}">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="13" Margin="0,0,8,0" Foreground="{StaticResource AccentBrush}" />
                                <TextBlock Text="{x:Static l:Strings.ForecastWin_CheckAgain}" Foreground="{StaticResource AccentBrush}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsChecking, Converter={StaticResource Visible}}">
                                <Control Style="{StaticResource Spinner}" Margin="0,0,8,0" />
                                <TextBlock Text="{x:Static l:Strings.ForecastWin_Checking}" />
                            </StackPanel>
                        </Grid>
                    </Button>
                    <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center">
                        <Run Text="{Binding CheckedText, Mode=OneWay}" FontWeight="SemiBold" /> <Run Text="·" /> <Run Text="{Binding SourceText, Mode=OneWay}" />
                    </TextBlock>
                </DockPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
