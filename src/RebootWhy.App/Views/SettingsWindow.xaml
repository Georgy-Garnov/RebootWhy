<Window x:Class="RebootWhy.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:RebootWhy.App.Controls"
        xmlns:l="clr-namespace:RebootWhy.App.Properties"
        Icon="pack://application:,,,/Assets/RebootWhy.ico"
        Title="{x:Static l:Strings.Settings_WindowTitle}" Width="980" Height="680" MinWidth="820" MinHeight="540"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource WindowBrush}" FontFamily="{StaticResource UiFont}" FontSize="13" Foreground="{StaticResource TextBrush}">
    <Window.Resources>
        <!-- Navigation item: icon + title; the selected one has an accent bar on the left -->
        <Style x:Key="NavItem" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand" />
            <!-- Name for screen readers and automation: the section title rather than the object's technical text. -->
            <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Chrome" Background="Transparent" CornerRadius="6" Padding="10,8" Margin="0,1">
                            <Grid>
                                <Border x:Name="Marker" Width="3" Height="16" CornerRadius="1.5" Background="{StaticResource AccentBrush}"
                                        HorizontalAlignment="Left" Margin="-10,0,0,0" Visibility="Hidden" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="15" Margin="0,0,12,0" Foreground="{StaticResource SecondaryTextBrush}" />
                                    <TextBlock x:Name="Caption" Text="{Binding Title}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource SelectionBrush}" />
                                <Setter TargetName="Marker" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Caption" Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingName" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="SettingHint" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>
        <Style x:Key="PolicyState" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        </Style>
        <Style x:Key="Page" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Bottom bar: status and buttons -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="20,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource AccentButton}" MinWidth="96" Content="{x:Static l:Strings.Settings_Ok}" IsDefault="True" Command="{Binding OkCommand}" />
                    <Button MinWidth="96" Margin="8,0,0,0" Content="{x:Static l:Strings.Settings_Cancel}" IsCancel="True" Command="{Binding CancelCommand}" />
                    <Button MinWidth="96" Margin="8,0,0,0" Content="{x:Static l:Strings.Settings_Apply}" Command="{Binding ApplyCommand}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Control Style="{StaticResource Spinner}" Margin="0,0,8,0" Visibility="{Binding IsBusy, Converter={StaticResource Visible}}" />
                    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" MaxWidth="560" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Navigation with search -->
            <Border Background="{StaticResource SubtleBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0" Padding="12,14">
                <DockPanel>
                    <controls:SearchBox DockPanel.Dock="Top" Margin="0,0,0,12" Text="{Binding SearchText}" Placeholder="{x:Static l:Strings.Settings_SearchPlaceholder}" />
                    <ListBox ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}" ItemContainerStyle="{StaticResource NavItem}"
                             Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                </DockPanel>
            </Border>

            <!-- Page -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="32,20,32,24" MaxWidth="760" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding SelectedPage.Title}" Style="{StaticResource PageTitle}" Margin="0,0,0,14" />

                    <!-- Alerts -->
                    <StackPanel Style="{StaticResource Page}" Visibility="{Binding PageKey, Converter={StaticResource VisibleWhenEquals}, ConverterParameter=alerts}">
                        <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,14"
                                   Text="{x:Static l:Strings.Settings_Alerts_Intro}" />
                        <Border Style="{StaticResource SettingRow}">
                            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowNotification}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SettingName}" Text="{x:Static l:Strings.Settings_Notification}" />
                                    <TextBlock Style="{StaticResource SettingHint}" Text="{x:Static l:Strings.Settings_Notification_Hint}" />
                                </StackPanel>
                            </CheckBox>
                        </Border>
                        <Border Style="{StaticResource SettingRow}">
                            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowAlertOnDetection}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SettingName}" Text="{x:Static l:Strings.Settings_AlertOnDetection}" />
                                    <TextBlock Style="{StaticResource SettingHint}" Text="{x:Static l:Strings.Settings_AlertOnDetection_Hint}" />
                                </StackPanel>
                            </CheckBox>
                        </Border>
                        <Border Style="{StaticResource SettingRow}">
                            <StackPanel>
                                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowAlertWindow}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SettingName}" Text="{x:Static l:Strings.Settings_AlertBefore}" />
                                        <TextBlock Style="{StaticResource SettingHint}" Text="{x:Static l:Strings.Settings_AlertBefore_Hint}" />
                                    </StackPanel>
                                </CheckBox>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0" IsEnabled="{Binding ShowAlertWindow}">
                                    <TextBlock Text="{x:Static l:Strings.Settings_AlertBefore_Prefix}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <ComboBox Width="150" ItemsSource="{Binding MinutesOptions}" SelectedItem="{Binding AlertMinutes}" DisplayMemberPath="Title" />
                                    <TextBlock Text="{x:Static l:Strings.Settings_AlertBefore_Suffix}" VerticalAlignment="Center" Margin="10,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SettingRow}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Command="{Binding StartSimulationCommand}"
                                            Visibility="{Binding IsSimulating, Converter={StaticResource Visible}, ConverterParameter=Invert}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE9D9;" FontSize="13" Margin="0,0,8,0" />
                                            <TextBlock Text="{x:Static l:Strings.Settings_StartTest}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Content="{x:Static l:Strings.Settings_StopTest}" Command="{Binding StopSimulationCommand}"
                                            Visibility="{Binding IsSimulating, Converter={StaticResource Visible}}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource SettingName}" Text="{x:Static l:Strings.Settings_ReactionTest}" />
                                    <TextBlock Style="{StaticResource SettingHint}"
                                               Text="{x:Static l:Strings.Settings_ReactionTest_Hint}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource SettingRow}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Command="{Binding ShowSampleCommand}" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" FontSize="12" Margin="0,0,8,0" />
                                        <TextBlock Text="{x:Static l:Strings.Settings_ShowSample}" />
                                    </StackPanel>
                                </Button>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource SettingName}" Text="{x:Static l:Strings.Settings_Sample}" />
                                    <TextBlock Style="{StaticResource SettingHint}" Text="{x:Static l:Strings.Settings_Sample_Hint}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>

                    <!-- Sound -->
                    <StackPanel Style="{StaticResource Page}" Visibility="{Binding PageKey, Converter={StaticResource VisibleWhenEquals}, ConverterParameter=sound}">
                        <Border Style="{StaticResource SettingRow}">
                            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding PlaySound}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SettingName}" Text="{x:Static l:Strings.Sound_Signal}" />
                                    <TextBlock Style="{StaticResource SettingHint}" Text="{x:Static l:Strings.Sound_Signal_Hint}" />
                                </StackPanel>
                            </CheckBox>
                        </Border>
                        <Border Style="{StaticResource SettingRow}" IsEnabled="{Binding PlaySound}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="{x:Static l:Strings.Sound_ChooseFile}" Command="{Binding ChooseSoundCommand}" />
                                    <Button Content="{x:Static l:Strings.Sound_Reset}" Margin="8,0,0,0" Command="{Binding ResetSoundCommand}" />
                                    <Button Margin="8,0,0,0" MinWidth="130" Command="{Binding TestSoundCommand}">
                                        <Grid>
                                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsSoundPlaying, Converter={StaticResource Visible}, ConverterParameter=Invert}">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" FontSize="12" Margin="0,0,8,0" />
                                                <TextBlock Text="{x:Static l:Strings.Sound_Listen}" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsSoundPlaying, Converter={StaticResource Visible}}">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE71A;" FontSize="12" Margin="0,0,8,0" />
                                                <TextBlock Text="{x:Static l:Strings.Sound_Stop}" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </StackPanel>
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE8D6;" FontSize="22" Margin="0,0,14,0" Foreground="{StaticResource AccentBrush}" />
                                <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SoundFileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding SoundFile}" />
                                    <TextBlock Text="{Binding SoundFileFolder}" Style="{StaticResource SettingHint}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <TextBlock Style="{StaticResource Caption}" Margin="4,4,0,0" Text="{x:Static l:Strings.Sound_Formats}" />
                    </StackPanel>

                    <!-- Restart protection -->
                    <StackPanel Style="{StaticResource Page}" Visibility="{Binding PageKey, Converter={StaticResource VisibleWhenEquals}, ConverterParameter=protection}">
                        <Border Style="{StaticResource SettingRow}">
                            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding KeepUserActive}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SettingName}" Text="{x:Static l:Strings.Settings_KeepActive}" />
                                    <TextBlock Style="{StaticResource SettingHint}" Text="{x:Static l:Strings.Settings_KeepActive_Hint}" />
                                </StackPanel>
                            </CheckBox>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SettingName}" FontWeight="SemiBold" Text="{x:Static l:Strings.Settings_HowItWorks}" />
                                <TextBlock TextWrapping="Wrap" Margin="0,8,0,0" Text="{x:Static l:Strings.Settings_HowItWorks_1}" />
                                <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" Text="{x:Static l:Strings.Settings_HowItWorks_2}" />
                                <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" Text="{x:Static l:Strings.Settings_HowItWorks_3}" />
                                <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" Text="{x:Static l:Strings.Settings_HowItWorks_4}" />
                                <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" Text="{x:Static l:Strings.Settings_HowItWorks_5}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Startup and service -->
                    <StackPanel Style="{StaticResource Page}" Visibility="{Binding PageKey, Converter={StaticResource VisibleWhenEquals}, ConverterParameter=startup}">
                        <Border Style="{StaticResource SettingRow}">
                            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Autostart}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SettingName}" Text="{x:Static l:Strings.Settings_Autostart}" />
                                    <TextBlock Style="{StaticResource SettingHint}" Text="{x:Static l:Strings.Settings_Autostart_Hint}" />
                                </StackPanel>
                            </CheckBox>
                        </Border>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static l:Strings.Service_Section}" />
                        <Border Style="{StaticResource SettingRow}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Command="{Binding InstallServiceCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xEA18;" FontSize="13" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding InstallServiceText}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Content="{x:Static l:Strings.Service_Remove}" Margin="8,0,0,0" Command="{Binding UninstallServiceCommand}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource SettingName}">
                                        <Run Text="{x:Static l:Strings.Service_StateLabel}" /> <Run Text="{Binding ServiceStatus, Mode=OneWay}" FontWeight="SemiBold" />
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource SettingHint}"
                                               Text="{x:Static l:Strings.Service_Hint}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>

                    <!-- Windows Update policies -->
                    <StackPanel Style="{StaticResource Page}" Visibility="{Binding PageKey, Converter={StaticResource VisibleWhenEquals}, ConverterParameter=policies}">
                        <Border Padding="14,10" CornerRadius="8" BorderThickness="1" Margin="0,0,0,12"
                                Background="{StaticResource WarningBackgroundBrush}" BorderBrush="{StaticResource WarningBorderBrush}">
                            <DockPanel>
                                <TextBlock Style="{StaticResource Icon}" Text="&#xEA18;" Foreground="{StaticResource WarningBrush}" Margin="0,0,10,0" VerticalAlignment="Top" />
                                <TextBlock TextWrapping="Wrap"
                                           Text="{x:Static l:Strings.Policy_Warning}" />
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource SettingRow}">
                            <StackPanel>
                                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding PolicyNoAutoReboot}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SettingName}" Text="{x:Static l:Strings.Policy_NoAutoReboot}" />
                                        <TextBlock Style="{StaticResource SettingHint}" Text="{x:Static l:Strings.Policy_NoAutoReboot_Hint}" />
                                    </StackPanel>
                                </CheckBox>
                                <TextBlock Style="{StaticResource PolicyState}" Text="{Binding NoAutoRebootState}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SettingRow}">
                            <StackPanel>
                                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding PolicyExcludeDrivers}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SettingName}" Text="{x:Static l:Strings.Policy_ExcludeDrivers}" />
                                        <TextBlock Style="{StaticResource SettingHint}" Text="{x:Static l:Strings.Policy_ExcludeDrivers_Hint}" />
                                    </StackPanel>
                                </CheckBox>
                                <TextBlock Style="{StaticResource PolicyState}" Text="{Binding ExcludeDriversState}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SettingRow}">
                            <StackPanel>
                                <DockPanel>
                                    <ComboBox DockPanel.Dock="Right" Width="320" VerticalAlignment="Center" ItemsSource="{Binding AutoUpdateOptions}"
                                              SelectedItem="{Binding PolicyAutoUpdate}" DisplayMemberPath="Title" />
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Style="{StaticResource SettingName}" Text="{x:Static l:Strings.Policy_AutoUpdate}" />
                                        <TextBlock Style="{StaticResource SettingHint}" Text="{x:Static l:Strings.Policy_AutoUpdate_Hint}" />
                                    </StackPanel>
                                </DockPanel>
                                <TextBlock Style="{StaticResource PolicyState}" Text="{Binding AutoUpdateState}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SettingRow}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" VerticalAlignment="Center" Command="{Binding OpenActiveHoursCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{x:Static l:Strings.Policy_WindowsUpdateSettings}" />
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8A7;" FontSize="12" Margin="8,0,0,0" />
                                    </StackPanel>
                                </Button>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource SettingName}" Text="{x:Static l:Strings.Policy_ActiveHours}" />
                                    <TextBlock Style="{StaticResource SettingHint}" Text="{Binding ActiveHoursText}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <TextBlock Margin="4,6,0,0" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap"
                                   Visibility="{Binding PoliciesDirty, Converter={StaticResource Visible}}"
                                   Text="{x:Static l:Strings.Policy_Unapplied}" />
                    </StackPanel>

                    <!-- Language -->
                    <StackPanel Style="{StaticResource Page}" Visibility="{Binding PageKey, Converter={StaticResource VisibleWhenEquals}, ConverterParameter=language}">
                        <Border Style="{StaticResource SettingRow}">
                            <DockPanel>
                                <ComboBox DockPanel.Dock="Right" Width="240" VerticalAlignment="Center" ItemsSource="{Binding LanguageOptions}"
                                          SelectedItem="{Binding LanguageOption}" DisplayMemberPath="Title"
                                          AutomationProperties.Name="{x:Static l:Strings.Language_Interface}" />
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource SettingName}" Text="{x:Static l:Strings.Language_Interface}" />
                                    <TextBlock Style="{StaticResource SettingHint}" Text="{x:Static l:Strings.Language_Interface_Hint}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Padding="14,10" CornerRadius="8" BorderThickness="1" Margin="0,4,0,0"
                                Background="{StaticResource WarningBackgroundBrush}" BorderBrush="{StaticResource WarningBorderBrush}"
                                Visibility="{Binding LanguageRestartNeeded, Converter={StaticResource Visible}}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" VerticalAlignment="Center" Margin="12,0,0,0"
                                        Content="{x:Static l:Strings.Language_RestartNow}" Command="{Binding RestartCommand}" />
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE774;" Foreground="{StaticResource WarningBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" Text="{x:Static l:Strings.Language_RestartNote}" />
                            </DockPanel>
                        </Border>
                    </StackPanel>

                    <!-- About -->
                    <StackPanel Style="{StaticResource Page}" Visibility="{Binding PageKey, Converter={StaticResource VisibleWhenEquals}, ConverterParameter=about}">
                        <Border Style="{StaticResource Card}">
                            <DockPanel>
                                <Image DockPanel.Dock="Left" Source="pack://application:,,,/Assets/RebootWhy.ico" Width="56" Height="56" Margin="0,0,16,0" RenderOptions.BitmapScalingMode="HighQuality" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="RebootWhy" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource Caption}" Text="{Binding Version, StringFormat={x:Static l:Strings.Settings_About_Version}}" />
                                    <TextBlock Style="{StaticResource Caption}" Text="{x:Static l:Strings.Settings_About_Tagline}" Margin="0,4,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource SettingRow}" Margin="0,10,0,6">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SettingName}" Text="{x:Static l:Strings.Settings_About_Program}" />
                                <TextBlock Style="{StaticResource SettingHint}" Text="{Binding ExecutablePath}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SettingRow}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="{x:Static l:Strings.Settings_About_OpenFolder}" VerticalAlignment="Center" Command="{Binding OpenSettingsFolderCommand}" />
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource SettingName}" Text="{x:Static l:Strings.Settings_About_SettingsFile}" />
                                    <TextBlock Style="{StaticResource SettingHint}" Text="{Binding SettingsPath}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
