<UserControl x:Class="RebootWhy.App.Controls.SearchBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:RebootWhy.App.Properties"
             x:Name="Root" Height="32" VerticalAlignment="Center">
    <!-- Search box: magnifier on the left, placeholder, clear button on the right (visible when there is text), Esc clears. -->
    <Grid>
        <TextBox x:Name="Input" Padding="30,0,30,0" VerticalContentAlignment="Center" Text="{Binding Text, ElementName=Root, UpdateSourceTrigger=PropertyChanged}"
                 PreviewKeyDown="OnKeyDown" AutomationProperties.Name="{Binding Placeholder, ElementName=Root}" />
        <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="13" Margin="10,0,0,0" HorizontalAlignment="Left"
                   Foreground="{StaticResource SecondaryTextBrush}" IsHitTestVisible="False" />
        <TextBlock x:Name="Hint" Text="{Binding Placeholder, ElementName=Root}" Margin="31,0,30,0" VerticalAlignment="Center"
                   Foreground="{StaticResource SecondaryTextBrush}" IsHitTestVisible="False" TextTrimming="CharacterEllipsis" />
        <Button x:Name="ClearButton" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0" Padding="6,3"
                Style="{StaticResource GhostButton}" MinHeight="0" Click="OnClear" ToolTip="{x:Static l:Strings.Search_Clear}" AutomationProperties.Name="{x:Static l:Strings.Search_ClearAutomation}" Visibility="Collapsed">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
        </Button>
    </Grid>
</UserControl>
