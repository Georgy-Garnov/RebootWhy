<Window x:Class="RebootWhy.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:RebootWhy.App.Infrastructure"
        xmlns:controls="clr-namespace:RebootWhy.App.Controls"
        xmlns:l="clr-namespace:RebootWhy.App.Properties"
        Icon="pack://application:,,,/Assets/RebootWhy.ico"
        Title="{x:Static l:Strings.Main_WindowTitle}"
        Width="1220" Height="800" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}" FontFamily="{StaticResource UiFont}" FontSize="13"
        Foreground="{StaticResource TextBrush}">
    <Window.Resources>
        <!-- Details panel: the same for reboots and updates -->
        <DataTemplate x:Key="FactTemplate">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                <TextBlock Grid.Column="1" infra:LinkText.Text="{Binding Value}" TextWrapping="Wrap" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="BulletTemplate">
            <DockPanel Margin="0,2">
                <TextBlock DockPanel.Dock="Left" Text="•" Margin="0,0,6,0" />
                <TextBlock infra:LinkText.Text="{Binding}" TextWrapping="Wrap" />
            </DockPanel>
        </DataTemplate>
        <Style x:Key="DetailsHeader" TargetType="TextBlock" BasedOn="{StaticResource SectionTitle}">
            <Setter Property="Margin" Value="0,16,0,6" />
            <!-- Translations can be longer than the panel is wide. -->
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="20,14,20,12">
        <!-- Header -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding OpenSettingsCommand}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" Margin="0,0,8,0" />
                    <TextBlock Text="{x:Static l:Strings.Main_Settings}" />
                </StackPanel>
            </Button>
            <Image Source="pack://application:,,,/Assets/RebootWhy.ico" Width="30" Height="30" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="RebootWhy" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="{x:Static l:Strings.Main_Subtitle}" Style="{StaticResource Caption}" />
            </StackPanel>
        </DockPanel>

        <!-- Uptime: only for the log of this computer -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,12" Visibility="{Binding IsLive, Converter={StaticResource Visible}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.3*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Text="{x:Static l:Strings.Main_Uptime}" />
                    <TextBlock Text="{Binding UptimeText}" FontSize="28" FontWeight="SemiBold" Margin="0,2,0,0" />
                    <TextBlock Style="{StaticResource Caption}" Text="{Binding UptimeSinceText}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Text="{x:Static l:Strings.Main_LastFullBoot}" />
                    <TextBlock Text="{Binding FullBootText}" FontSize="16" Margin="0,8,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Text="{x:Static l:Strings.Main_ActiveTime}" />
                    <TextBlock Text="{Binding ActiveTimeText}" FontSize="16" Margin="0,8,0,0" />
                    <TextBlock Style="{StaticResource Caption}" Text="{x:Static l:Strings.Main_ActiveTimeCaption}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Windows updates: is the system waiting for a restart -->
        <Border DockPanel.Dock="Top" Margin="0,0,0,10" Padding="14,10" CornerRadius="8" BorderThickness="1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{StaticResource SuccessBackgroundBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource SuccessBorderBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding UpdateSeverity}" Value="Warning">
                            <Setter Property="Background" Value="{StaticResource DangerBackgroundBrush}" />
                            <Setter Property="BorderBrush" Value="{StaticResource DangerBorderBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding UpdateSeverity}" Value="Critical">
                            <Setter Property="Background" Value="{StaticResource DangerBackgroundBrush}" />
                            <Setter Property="BorderBrush" Value="{StaticResource DangerBorderBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{x:Static l:Strings.Main_StopTest}" Margin="8,0,0,0" Command="{Binding StopSimulationCommand}"
                            Visibility="{Binding IsSimulating, Converter={StaticResource Visible}}" />
                    <Button Content="{x:Static l:Strings.Main_Details}" Margin="8,0,0,0" Command="{Binding OpenForecastCommand}" />
                    <Button Margin="8,0,0,0" MinWidth="120" Command="{Binding AnalyzeUpdatesCommand}">
                        <Grid>
                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsCheckingUpdates, Converter={StaticResource Visible}, ConverterParameter=Invert}">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="13" Margin="0,0,8,0" />
                                <TextBlock Text="{x:Static l:Strings.Main_Check}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsCheckingUpdates, Converter={StaticResource Visible}}">
                                <Control Style="{StaticResource Spinner}" Margin="0,0,8,0" />
                                <TextBlock Text="{x:Static l:Strings.Main_Checking}" />
                            </StackPanel>
                        </Grid>
                    </Button>
                </StackPanel>
                <TextBlock DockPanel.Dock="Left" FontFamily="{StaticResource IconFont}" FontSize="20" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="&#xE930;" />
                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding UpdateSeverity}" Value="Warning">
                                    <Setter Property="Text" Value="&#xE7BA;" />
                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding UpdateSeverity}" Value="Critical">
                                    <Setter Property="Text" Value="&#xE7BA;" />
                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock TextWrapping="Wrap">
                        <Run Text="{x:Static l:Strings.Main_UpdatesLabel}" FontWeight="SemiBold" /> <Run Text="{Binding UpdateSummary, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Text="{Binding UpdateSourceText}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Top" Margin="0,0,0,10" Padding="14,8" CornerRadius="8" BorderThickness="1"
                Background="{StaticResource WarningBackgroundBrush}" BorderBrush="{StaticResource WarningBorderBrush}"
                Visibility="{Binding HasFastStartupHint, Converter={StaticResource Visible}}">
            <DockPanel>
                <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" Foreground="{StaticResource WarningBrush}" Margin="0,0,10,0" />
                <TextBlock Text="{Binding FastStartupHint}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- Status bar -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Control DockPanel.Dock="Left" Style="{StaticResource Spinner}" Margin="0,0,8,0"
                     Visibility="{Binding IsBusy, Converter={StaticResource Visible}}" />
            <TextBlock Style="{StaticResource Caption}" Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
        </DockPanel>

        <TabControl x:Name="Tabs" SelectionChanged="OnTabChanged">
            <!-- Reboots -->
            <TabItem Header="{x:Static l:Strings.Main_TabReboots}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="{x:Static l:Strings.Reboots_Period}" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource SecondaryTextBrush}"
                                   Visibility="{Binding IsLive, Converter={StaticResource Visible}}" />
                        <ComboBox Width="120" ItemsSource="{Binding Periods}" SelectedItem="{Binding SelectedPeriod}" DisplayMemberPath="Title"
                                  Visibility="{Binding IsLive, Converter={StaticResource Visible}}" />
                        <CheckBox Style="{StaticResource ToggleSwitch}" Content="{x:Static l:Strings.Reboots_OnlyFullBoots}" IsChecked="{Binding OnlyFullBoots}"
                                  VerticalAlignment="Center" Margin="20,0,0,0" />
                        <Button Margin="20,0,0,0" Command="{Binding RefreshCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="13" Margin="0,0,8,0" />
                                <TextBlock Text="{x:Static l:Strings.Main_Refresh}" />
                            </StackPanel>
                        </Button>
                        <Button Margin="8,0,0,0" Command="{Binding OpenFileCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8E5;" FontSize="13" Margin="0,0,8,0" />
                                <TextBlock Text="{x:Static l:Strings.Reboots_OpenEvtx}" />
                            </StackPanel>
                        </Button>
                        <Button Margin="8,0,0,0" Content="{x:Static l:Strings.Reboots_ThisComputer}" Command="{Binding UseLiveLogCommand}"
                                Visibility="{Binding IsFile, Converter={StaticResource Visible}}" />
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="440" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="0.6*" MinWidth="340" MaxWidth="640" />
                        </Grid.ColumnDefinitions>

                        <ListView x:Name="RebootList" ItemsSource="{Binding Records}" SelectedItem="{Binding SelectedRecord}" SizeChanged="FitTitleColumn">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Width="30">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Ellipse Style="{StaticResource SeverityDot}" Margin="6,0,0,0" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="{x:Static l:Strings.Reboots_ColumnBoot}" Width="120" DisplayMemberBinding="{Binding TimeText}" />
                                    <GridViewColumn Header="{x:Static l:Strings.Reboots_ColumnWhat}" Width="320" x:Name="RebootTitleColumn">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="{x:Static l:Strings.Reboots_ColumnBootType}" Width="150" DisplayMemberBinding="{Binding BootTypeText}" />
                                    <GridViewColumn Header="{x:Static l:Strings.Reboots_ColumnConfidence}" Width="90" DisplayMemberBinding="{Binding ConfidenceText}" />
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Stretch" Background="Transparent" />

                        <Border Grid.Column="2" Style="{StaticResource Card}">
                            <Grid>
                                <TextBlock Text="{x:Static l:Strings.Reboots_SelectHint}" Style="{StaticResource Caption}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding HasNoSelection, Converter={StaticResource Visible}}" />
                                <DockPanel Visibility="{Binding HasSelection, Converter={StaticResource Visible}}">
                                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                        <Button DockPanel.Dock="Right" MinWidth="130" Command="{Binding CopySelectedCommand}" ToolTip="{x:Static l:Strings.Reboots_CopyTooltip}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" FontSize="13" Margin="0,0,8,0" />
                                                <TextBlock Text="{Binding CopyButtonText}" />
                                            </StackPanel>
                                        </Button>
                                        <TextBlock Style="{StaticResource Caption}" Text="{x:Static l:Strings.Main_DetailsHeader}" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <ScrollViewer DataContext="{Binding SelectedRecord}" VerticalScrollBarVisibility="Auto">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8" />
                                            <ItemsControl ItemsSource="{Binding Facts}" ItemTemplate="{StaticResource FactTemplate}" />
                                            <StackPanel Visibility="{Binding HasNotes, Converter={StaticResource Visible}}">
                                                <TextBlock Style="{StaticResource DetailsHeader}" Text="{x:Static l:Strings.Reboots_Notes}" />
                                                <ItemsControl ItemsSource="{Binding Notes}" ItemTemplate="{StaticResource BulletTemplate}" />
                                            </StackPanel>
                                            <StackPanel Visibility="{Binding HasUpdates, Converter={StaticResource Visible}}">
                                                <TextBlock Style="{StaticResource DetailsHeader}" Text="{x:Static l:Strings.Reboots_InstalledUpdates}" />
                                                <ItemsControl ItemsSource="{Binding Updates}" ItemTemplate="{StaticResource BulletTemplate}" />
                                            </StackPanel>
                                            <TextBlock Style="{StaticResource DetailsHeader}" Text="{x:Static l:Strings.Reboots_Evidence}" />
                                            <ItemsControl ItemsSource="{Binding Evidence}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" TextWrapping="Wrap" Margin="0,1"
                                                                   Foreground="{StaticResource SecondaryTextBrush}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </ScrollViewer>
                                </DockPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- Updates -->
            <TabItem Header="{x:Static l:Strings.Main_TabUpdates}">
                <DockPanel DataContext="{Binding Updates}">
                    <!-- In a narrow window the toolbar wraps to a second line instead of being clipped. -->
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                        <controls:SearchBox Width="300" Margin="0,0,20,6" Text="{Binding SearchText}"
                                            Placeholder="{x:Static l:Strings.Updates_SearchPlaceholder}" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <CheckBox Style="{StaticResource ToggleSwitch}" Content="{x:Static l:Strings.Updates_OnlyImportant}" IsChecked="{Binding OnlyImportant}" VerticalAlignment="Center"
                                      ToolTip="{x:Static l:Strings.Updates_OnlyImportantTooltip}" />
                            <CheckBox Style="{StaticResource ToggleSwitch}" Content="{x:Static l:Strings.Updates_OnlyReboot}" IsChecked="{Binding OnlyReboot}" VerticalAlignment="Center"
                                      Margin="20,0,0,0" ToolTip="{x:Static l:Strings.Updates_OnlyRebootTooltip}" />
                            <Button Margin="20,0,0,0" Command="{Binding RefreshCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="13" Margin="0,0,8,0" />
                                    <TextBlock Text="{x:Static l:Strings.Main_Refresh}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </WrapPanel>

                    <!-- History status on its own line: there is not enough room next to the buttons on a narrow tab. -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="2,0,0,8">
                        <Control Style="{StaticResource Spinner}" Margin="0,0,8,0" Visibility="{Binding IsBusy, Converter={StaticResource Visible}}" />
                        <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="440" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="0.6*" MinWidth="340" MaxWidth="640" />
                        </Grid.ColumnDefinitions>

                        <!-- With groups WPF does not virtualize rows by default and builds hundreds at once, so enable it explicitly. -->
                        <ListView x:Name="UpdateList" ItemsSource="{Binding View}" SelectedItem="{Binding Selected}" SizeChanged="FitTitleColumn"
                                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True">
                            <!-- Rows of updates requiring a restart: orange means it may be needed, red means it will be. -->
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Reboot}" Value="Maybe">
                                            <Setter Property="Background" Value="#FFEFD9" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Reboot}" Value="Always">
                                            <Setter Property="Background" Value="#FDE3E0" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource SubtleBrush}" Padding="10,8" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                                                <TextBlock FontWeight="SemiBold">
                                                    <Run Text="{Binding Name, Mode=OneWay}" /> <Run Text="{Binding ItemCount, Mode=OneWay, StringFormat='· {0}'}" Foreground="{StaticResource SecondaryTextBrush}" />
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListView.GroupStyle>
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Width="46">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Background="Transparent" ToolTip="{Binding RebootHint}">
                                                    <Ellipse Style="{StaticResource SeverityDot}" Margin="6,0,0,0" />
                                                    <!-- ↻ means the installation will (red) or may (amber) require a restart. -->
                                                    <TextBlock FontFamily="{StaticResource IconFont}" FontSize="13" Text="&#xE777;" Margin="7,0,0,0" VerticalAlignment="Center"
                                                               Visibility="{Binding NeedsReboot, Converter={StaticResource Visible}}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#C77700" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Reboot}" Value="Always">
                                                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="{x:Static l:Strings.Updates_ColumnDate}" Width="132" DisplayMemberBinding="{Binding TimeText}" />
                                    <GridViewColumn Header="{x:Static l:Strings.Updates_ColumnUpdate}" Width="300" x:Name="UpdateTitleColumn">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="{x:Static l:Strings.Updates_ColumnResult}" Width="125">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusText}" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="{x:Static l:Strings.Updates_ColumnType}" Width="130">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding KindText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding KindText}" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Stretch" Background="Transparent" />

                        <Border Grid.Column="2" Style="{StaticResource Card}">
                            <Grid>
                                <TextBlock Text="{x:Static l:Strings.Updates_SelectHint}" Style="{StaticResource Caption}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding HasSelection, Converter={StaticResource Visible}, ConverterParameter=Invert}" />
                                <DockPanel Visibility="{Binding HasSelection, Converter={StaticResource Visible}}">
                                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                        <Button DockPanel.Dock="Right" MinWidth="130" Command="{Binding CopyCommand}" ToolTip="{x:Static l:Strings.Updates_CopyTooltip}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" FontSize="13" Margin="0,0,8,0" />
                                                <TextBlock Text="{Binding CopyButtonText}" />
                                            </StackPanel>
                                        </Button>
                                        <TextBlock Style="{StaticResource Caption}" Text="{x:Static l:Strings.Main_DetailsHeader}" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <ScrollViewer DataContext="{Binding Selected}" VerticalScrollBarVisibility="Auto">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8" />
                                            <ItemsControl ItemsSource="{Binding Facts}" ItemTemplate="{StaticResource FactTemplate}" />
                                            <StackPanel Visibility="{Binding HasDescription, Converter={StaticResource Visible}}">
                                                <TextBlock Style="{StaticResource DetailsHeader}" Text="{x:Static l:Strings.Updates_Description}" />
                                                <TextBlock infra:LinkText.Text="{Binding Description}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </StackPanel>
                                    </ScrollViewer>
                                </DockPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
